+static const struct child_process *dream_gpg_permit;
+static unsigned dream_gpg_attempts;
+void dream_proof_permit_gpg(const struct child_process *cmd)
+{
+ if (dream_gpg_attempts || dream_gpg_permit) die("Dream: extra GPG attempt refused");
+ dream_gpg_permit = cmd;
+}
