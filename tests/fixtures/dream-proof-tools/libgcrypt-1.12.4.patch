# Refuse ambient startup configuration and optional syslog before service effects.
--- a/src/global.c
+++ b/src/global.c
@@ -35,0 +36,16 @@
+
+/* bboxy450-harness public-only finite profile. Adapted from Libgcrypt
+ * 1.12.4, original LGPL-2.1-or-later terms/notices retained.
+ * https://github.com/bboxy450/bboxy450-harness/blob/main/ATTRIBUTION.md
+ * Refuse optional system logging BEFORE its socket/service effect. Preserve
+ * an explicit failure, never a successful cryptographic verification. */
+static void
+dream_refuse_service (void)
+{
+  static const char message[] = "Dream profile: unsupported libgcrypt service/configuration\n";
+  (void)write (STDERR_FILENO, message, sizeof message - 1);
+  _exit (78);
+}
+#ifdef HAVE_SYSLOG
+# define syslog(...) dream_refuse_service ()
+#endif
