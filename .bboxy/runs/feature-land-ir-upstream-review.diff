+def checker_sha256(root=None):
+    """Hash tracked checker sources using their current working-tree bytes."""
+    root = Path(root or ROOT)
+    paths = ("scripts/formal.py", "scripts/test-formal.py", "crates/bboxy450-tlc", "crates/bbt-yarn")
