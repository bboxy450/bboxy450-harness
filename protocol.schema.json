            "session": {
              "$ref": "#/$defs/SessionId"
            }
          },
          "required": [
            "kind",
            "session"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "unknown"
            }
          },
          "required": [
            "kind"
          ]
        }
