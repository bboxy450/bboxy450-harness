              "const": "file_change"
            },
            "path": {
              "type": "string"
            },
            "unified": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path",
            "change",
            "unified"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "turn_diff"
            },
            "unified": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "unified"
          ]
        },
        {
          "type": "object",
          "properties": {
            "command": {
              "type": "string"
            },
            "exit": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int32"
            },
            "kind": {
              "type": "string",
              "const": "terminal"
            },
            "live": {
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "output": {
              "anyOf": [
                {
                  "$ref": "#/$defs/BlobRef"
                },
                {
                  "type": "null"
                }
              ]
            },
            "signal": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int32"
            },
            "terminal": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "terminal",
            "command"
          ]
        },
        {
          "type": "object",
          "properties": {
            "entries": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/PlanEntry"
              }
            },
            "kind": {
              "type": "string",
              "const": "plan"
            }
          },
          "required": [
            "kind",
            "entries"
          ]
        },
        {
          "type": "object",
          "properties": {
            "by": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Resolver"
                },
                {
                  "type": "null"
                }
              ]
            },
            "decision": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ApprovalDecision"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "type": "string",
              "const": "approval"
            },
            "options": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ApprovalDecisionKind"
              }
            },
            "subject": {
              "$ref": "#/$defs/ApprovalSubject"
            }
          },
          "required": [
            "kind",
            "subject",
            "options"
          ]
        },
        {
          "type": "object",
          "properties": {
            "blob": {
              "$ref": "#/$defs/BlobRef"
            },
            "kind": {
              "type": "string",
              "const": "image"
            },
            "mime": {
              "type": "string"
            }
          },
          "required": [
