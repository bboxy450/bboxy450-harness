{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProtocolSchema",
  "type": "object",
  "properties": {
    "envelope": {
      "$ref": "#/$defs/Envelope"
    },
    "op": {
      "$ref": "#/$defs/OpEnvelope"
    }
  },
  "required": [
    "envelope",
    "op"
  ],
  "$defs": {
    "ApprovalDecision": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "const": "allow"
            }
          },
          "required": [
            "decision"
          ]
        },
        {
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "const": "allow_always"
            }
          },
          "required": [
            "decision"
          ]
        },
        {
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "const": "deny"
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "decision"
          ]
        },
        {
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "const": "unknown"
            }
          },
          "required": [
            "decision"
          ]
        }
      ]
    },
    "ApprovalDecisionKind": {
      "type": "string",
      "enum": [
        "allow",
        "allow_always",
        "deny",
        "unknown"
      ]
    },
    "ApprovalSubject": {
      "type": "object",
      "properties": {
        "command": {
          "type": [
            "string",
            "null"
          ]
        },
        "effect": {
          "$ref": "#/$defs/Effect"
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "summary": {
          "type": "string"
        },
        "tool_call": {
          "$ref": "#/$defs/ItemId"
        }
      },
      "required": [
        "tool_call",
        "effect",
        "summary",
        "paths"
      ]
    },
    "BlobRef": {
      "type": "object",
      "properties": {
        "len": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "mime": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "sha256",
        "len",
        "mime"
      ]
    },
    "ChangeKind": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "add"
            }
          },
          "required": [
            "op"
          ]
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "modify"
            }
          },
          "required": [
            "op"
          ]
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "delete"
            }
          },
          "required": [
            "op"
          ]
        },
        {
          "type": "object",
          "properties": {
            "from": {
              "type": "string"
            },
            "op": {
              "type": "string",
              "const": "rename"
            }
          },
          "required": [
            "op",
            "from"
          ]
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "unknown"
            }
          },
          "required": [
            "op"
          ]
        }
      ]
    },
    "Delta": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "append": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "text"
            }
          },
          "required": [
            "type",
            "append"
          ]
        },
        {
          "type": "object",
          "properties": {
            "append": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "reasoning"
            }
          },
          "required": [
            "type",
            "append"
          ]
        },
        {
          "type": "object",
          "properties": {
            "append": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "tool_input"
            }
          },
          "required": [
            "type",
            "append"
          ]
        },
        {
          "type": "object",
          "properties": {
            "append": {
              "type": "string"
            },
            "stream": {
              "$ref": "#/$defs/Stream"
            },
            "type": {
              "type": "string",
              "const": "output"
            }
          },
          "required": [
            "type",
            "stream",
            "append"
          ]
        },
        {
          "type": "object",
          "properties": {
            "entries": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/PlanEntry"
              }
            },
            "type": {
              "type": "string",
              "const": "plan"
            }
          },
          "required": [
            "type",
            "entries"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "unknown"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "Effect": {
      "type": "string",
      "enum": [
        "write",
        "exec",
        "network",
        "unknown"
      ]
    },
    "Envelope": {
      "type": "object",
      "properties": {
        "at": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cause": {
          "anyOf": [
            {
              "$ref": "#/$defs/OpId"
            },
            {
              "type": "null"
            }
          ]
        },
        "epoch": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "event": {
          "$ref": "#/$defs/Event"
        },
        "seq": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "session": {
          "$ref": "#/$defs/SessionId"
        },
        "ts_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "v": {
          "$ref": "#/$defs/Version"
        }
      },
      "required": [
        "v",
        "session",
        "epoch",
        "at",
        "ts_ms",
        "event"
      ]
    },
    "ErrorClass": {
      "type": "string",
      "enum": [
        "transient",
        "rate_limited",
        "auth",
        "bad_request",
        "malformed",
        "mid_stream",
        "cancelled",
        "config",
        "store",
        "tool",
        "internal",
        "unknown"
      ]
    },
    "Event": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "meta": {
              "$ref": "#/$defs/SessionMeta"
            },
            "type": {
              "type": "string",
              "const": "session_started"
            }
          },
          "required": [
            "type",
            "meta"
          ]
        },
        {
          "type": "object",
          "properties": {
            "closed_items": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "closed_turns": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "prior_epoch": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "session_recovered"
            }
          },
          "required": [
            "type",
            "prior_epoch",
            "closed_items",
            "closed_turns"
          ]
        },
        {
          "type": "object",
          "properties": {
            "model": {
              "type": "string"
            },
            "profile": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "profile_changed"
            }
          },
          "required": [
            "type",
            "profile",
            "model"
          ]
        },
        {
          "type": "object",
          "properties": {
            "turn": {
              "$ref": "#/$defs/TurnId"
            },
            "type": {
              "type": "string",
              "const": "turn_queued"
            }
          },
          "required": [
            "type",
            "turn"
          ]
        },
        {
          "type": "object",
          "properties": {
            "turn": {
              "$ref": "#/$defs/TurnId"
            },
            "type": {
              "type": "string",
              "const": "turn_started"
            }
          },
          "required": [
            "type",
            "turn"
          ]
        },
        {
          "type": "object",
          "properties": {
            "head": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ItemHead"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "item": {
              "$ref": "#/$defs/ItemId"
            },
            "kind": {
              "$ref": "#/$defs/ItemKind"
            },
            "parent": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ItemId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "turn": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TurnId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "item_started"
            }
          },
          "required": [
            "type",
            "item",
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "body": {
              "$ref": "#/$defs/Item"
            },
            "item": {
              "$ref": "#/$defs/ItemId"
            },
            "status": {
              "$ref": "#/$defs/ItemStatus"
            },
            "type": {
              "type": "string",
              "const": "item_completed"
            }
          },
          "required": [
            "type",
            "item",
            "status",
            "body"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason": {
              "$ref": "#/$defs/StopReason"
            },
            "turn": {
              "$ref": "#/$defs/TurnId"
            },
            "type": {
              "type": "string",
              "const": "turn_ended"
            },
            "usage": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Usage"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "turn",
            "reason"
          ]
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "$ref": "#/$defs/OpId"
            },
            "reason": {
              "$ref": "#/$defs/Rejection"
            },
            "type": {
              "type": "string",
              "const": "op_rejected"
            }
          },
          "required": [
            "type",
            "op",
            "reason"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "session_closed"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "delta": {
              "$ref": "#/$defs/Delta"
            },
            "item": {
              "$ref": "#/$defs/ItemId"
            },
            "type": {
              "type": "string",
              "const": "item_delta"
            }
          },
          "required": [
            "type",
            "item",
            "delta"
          ]
        },
        {
          "type": "object",
          "properties": {
            "item": {
              "$ref": "#/$defs/ItemId"
            },
            "partial": {
              "$ref": "#/$defs/Item"
            },
            "type": {
              "type": "string",
              "const": "item_snapshot"
            }
          },
          "required": [
            "type",
            "item",
            "partial"
          ]
        },
        {
          "type": "object",
          "properties": {
            "phase": {
              "$ref": "#/$defs/Phase"
            },
            "type": {
              "type": "string",
              "const": "status"
            }
          },
          "required": [
            "type",
            "phase"
          ]
        },
        {
          "type": "object",
          "properties": {
            "resume_after": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "lagged"
            }
          },
          "required": [
            "type",
            "resume_after"
          ]
        },
        {
          "type": "object",
          "properties": {
            "epoch": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "head": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "reset"
            }
          },
          "required": [
            "type",
            "epoch",
            "head"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "unknown"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "InputBlock": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "text"
            }
          },
          "required": [
            "type",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "blob": {
              "$ref": "#/$defs/BlobRef"
            },
            "type": {
              "type": "string",
              "const": "image"
            }
          },
          "required": [
            "type",
            "blob"
          ]
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "mention"
            }
          },
          "required": [
            "type",
            "path"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "unknown"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "Item": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "blocks": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/InputBlock"
              }
            },
            "kind": {
